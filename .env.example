# Copy to .env for local development:  cp .env.example .env
# Every value below is a development default. Replace ALL secrets before any real deployment.

ENVIRONMENT=development
LOG_LEVEL=INFO

# White-label branding (one place for the product name)
PRODUCT_NAME=CiteBase
PRODUCT_TAGLINE=Ask your documents. Get answers you can verify.
APP_BASE_URL=http://localhost:8080

# Postgres roles (created on first start by infra/postgres/init)
POSTGRES_PASSWORD=dev-postgres-superuser-change-me
CITEBASE_OWNER_PASSWORD=dev-owner-change-me
CITEBASE_APP_PASSWORD=dev-app-change-me

# Signs tokens and CSRF values. At least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-key-change-me-0123456789abcdef

# Cookies need HTTPS when true. Keep false only for http://localhost.
COOKIE_SECURE=false

# Email (Mailpit catches everything in development: http://localhost:8025).
# Production: your provider's SMTP host, port 587, STARTTLS true, username and password.
EMAIL_BACKEND=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
EMAIL_FROM=CiteBase <no-reply@citebase.local>

# AI provider keys (Phase 3). One is enough. Never commit real keys.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Models and limits (defaults shown; see backend/app/core/config.py)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_CHEAP_MODEL=gemini-3.5-flash-lite
# Embedding profile for new workspaces: 2 = Gemini API, 1 = local model (needs the embedder service)
DEFAULT_EMBEDDING_PROFILE=2
# AI tokens per workspace per month (0 = unlimited)
MONTHLY_TOKEN_LIMIT=2000000
# Days before deleted documents are purged
RETENTION_DAYS=30

# Production only (compose.prod.yaml): your domain; Caddy gets HTTPS certificates for it.
# Also set ENVIRONMENT=production, APP_BASE_URL=https://<domain> and COOKIE_SECURE=true.
SITE_ADDRESS=

# Text recognition (OCR) for scanned PDFs and PNG/JPEG images (Tesseract, runs on this server).
# More languages: list Tesseract codes in TESSERACT_LANGS (installed at build time, for example
# "eng deu fra") and join the same codes with "+" in OCR_LANGUAGES (for example eng+deu+fra).
OCR_ENABLED=true
TESSERACT_LANGS=eng
OCR_LANGUAGES=eng
OCR_MAX_PAGES=100

# Uploads and invitations wait until the account's email is confirmed (link sent at sign-up).
REQUIRE_VERIFIED_EMAIL=true
