# Copy to .env for local development:  cp .env.example .env
# Every value below is a development default. Replace ALL secrets before any real deployment.

ENVIRONMENT=development
LOG_LEVEL=INFO

# White-label branding (one place for the product name)
PRODUCT_NAME=CiteBase
PRODUCT_TAGLINE=Ask your documents. Get answers you can verify.
APP_BASE_URL=http://localhost:8080

# Postgres roles (created on first start by infra/postgres/init)
POSTGRES_PASSWORD=dev-postgres-superuser-change-me
CITEBASE_OWNER_PASSWORD=dev-owner-change-me
CITEBASE_APP_PASSWORD=dev-app-change-me

# Signs tokens and CSRF values. At least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-key-change-me-0123456789abcdef

# Cookies need HTTPS when true. Keep false only for http://localhost.
COOKIE_SECURE=false

# Email (Mailpit catches everything in development: http://localhost:8025)
EMAIL_BACKEND=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_FROM=CiteBase <no-reply@citebase.local>

# AI provider keys (Phase 3). One is enough. Never commit real keys.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
